# NodeODM is exposed by docker-compose.yml on the host machine.
NODEODM_HOST=127.0.0.1
NODEODM_PORT=3000
NODEODM_PROTOCOL=http

# Polling and local output defaults for process-test-scan.
NODEODM_POLL_INTERVAL_MS=5000
NODEODM_OUTPUT_DIR=./data/nodeodm-results

# YardOS aerial vision service. Use "mock" for a zero-weight demo or "yolo"
# with a pretrained/fine-tuned Ultralytics checkpoint.
VISION_SERVICE_URL=http://127.0.0.1:8000
VISION_PROVIDER=mock
VISION_MODEL_PATH=yolo11n.pt
VISION_MODEL_VERSION=yolo11n-visdrone-bootstrap
VISION_CONFIDENCE=0.25
VISION_TILE_SIZE=1024
VISION_TILE_OVERLAP=128
VISION_NMS_IOU=0.50
VISION_OUTPUT_DIR=./data/vision

# Training/data paths are intentionally outside source control.
VISDRONE_RAW_DIR=./services/vision/training/datasets/raw
VISION_DATASETS_DIR=./services/vision/training/datasets
VISION_TRAIN_MODEL=yolo11n.pt
VISION_EPOCHS=50
VISION_IMAGE_SIZE=1024

# Core application
DATABASE_URL=postgresql+psycopg://yardos:yardos@db:5432/yardos
NEXT_PUBLIC_API_URL=http://localhost:8000
DEMO_MODE=true
DRONE_MODE=simulation
DRONE_ALLOW_REAL_FLIGHT=false
MAVSDK_SYSTEM_ADDRESS=udp://:14540
